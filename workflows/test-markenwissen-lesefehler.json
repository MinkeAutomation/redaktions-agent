    {
      "id": "419522ec-729a-4528-9ab9-a9c4b905776e",
      "name": "Eingabe prüfen [Code]",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        896
      ],
      "parameters": {
        "jsCode": "// Guardrail Ebene 2: nur gültige Kundenkennung, Thema gekürzt\nconst out = [];\nfor (const item of $input.all()) {\n  const kuerzel = String(item.json.kuerzel ?? '').trim().toLowerCase();\n  const thema = String(item.json.thema ?? '').trim().slice(0, 300);\n  const ok = /^[a-z0-9-]{2,40}$/.test(kuerzel);\n  out.push({ json: { kuerzel: kuerzel, thema: thema, eingabe_ok: ok } });\n}\nreturn out.slice(0, 1);"
      }
    },
    {
      "id": "d5d6e8c7-afcf-48d8-9e13-3646630c4422",
      "name": "Eingabe gültig? [If]",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        704,
        896
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.eingabe_ok }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
