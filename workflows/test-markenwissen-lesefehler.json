    {
      "id": "7fee5241-ef90-473d-85e3-0a0c31df8eb1",
      "name": "Antwort bauen [Code]",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1728,
        896
      ],
      "parameters": {
        "jsCode": "// Rückgabe an den Agenten: fester Text, Nicht-Treffer-Wert NICHT_GEFUNDEN\n// v03 (10.11.2026): Lesefehler hat Vorrang. alwaysOutputData liefert bei einem Fehler zusätzlich ein leeres Element am Erfolgsausgang (Lauf 2608), dann liefen NICHT_GEFUNDEN und FEHLER parallel und die Rückgabe hing an der Reihenfolge. Jetzt prüft dieser Knoten die Fehlerausgänge selbst.\nconst lesefehler = (name) => { try { return $(name).all(1).length > 0; } catch (e) { return false; } };\nif (lesefehler('Markenwissen lesen [Supabase]') || lesefehler('Frühere Posts lesen [Supabase]')) {\n  return [{ json: { antwort: 'FEHLER: Markenwissen konnte nicht gelesen werden, Werkzeug nicht ausgeführt.' } }];\n}\nconst marken = $('Markenwissen lesen [Supabase]').all().map(i => i.json).filter(r => r && r.kuerzel);\nif (marken.length === 0) {\n  return [{ json: { antwort: 'NICHT_GEFUNDEN: Für diese Kundenkennung gibt es keine aktive Marke.' } }];\n}\nconst m = marken[0];\nconst posts = $('Frühere Posts lesen [Supabase]').all().map(i => i.json).filter(r => r && r.topic);\nconst liste = posts.map(p => '- ' + String(p.created_at || '').slice(0, 10) + ' | ' + (p.status || '') + ' | ' + p.topic + (p.rejection_reason ? ' | abgelehnt: ' + p.rejection_reason : '')).join('\\n') || '- keine früheren Posts';\nconst thema = $('Eingabe prüfen [Code]').first().json.thema || '(nicht genannt)';\nconst zeilen = [\n  'STATUS: OK',\n  'Marke: ' + (m.name || ''),\n  'Ton: ' + (m.ton || ''),\n  'Zielgruppe: ' + (m.zielgruppe || ''),\n  'No-Gos: ' + ((m.no_gos || []).join(', ') || 'keine'),\n  'Call to Action: ' + (m.cta_text || ''),\n  'Feste Hashtags: ' + ((m.hashtags_fest || []).join(' ') || 'keine'),\n  'Thema der Anfrage: ' + thema,\n  'Frühere Posts (neueste zuerst, höchstens 20):',\n  liste\n];\nreturn [{ json: { antwort: zeilen.join('\\n') } }];\n"
      }
    },
