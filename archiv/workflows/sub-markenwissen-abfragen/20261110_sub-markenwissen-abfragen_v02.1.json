                  {
                      "parameters":  {
                                         "jsCode":  "// Rückgabe an den Agenten: fester Text, Nicht-Treffer-Wert NICHT_GEFUNDEN\nconst marken = $(\u0027Markenwissen lesen [Supabase]\u0027).all().map(i =\u003e i.json).filter(r =\u003e r \u0026\u0026 r.kuerzel);\nif (marken.length === 0) {\n  return [{ json: { antwort: \u0027NICHT_GEFUNDEN: Für diese Kundenkennung gibt es keine aktive Marke.\u0027 } }];\n}\nconst m = marken[0];\nconst posts = $(\u0027Frühere Posts lesen [Supabase]\u0027).all().map(i =\u003e i.json).filter(r =\u003e r \u0026\u0026 r.topic);\nconst liste = posts.map(p =\u003e \u0027- \u0027 + String(p.created_at || \u0027\u0027).slice(0, 10) + \u0027 | \u0027 + (p.status || \u0027\u0027) + \u0027 | \u0027 + p.topic + (p.rejection_reason ? \u0027 | abgelehnt: \u0027 + p.rejection_reason : \u0027\u0027)).join(\u0027\\n\u0027) || \u0027- keine früheren Posts\u0027;\nconst thema = $(\u0027Eingabe prüfen [Code]\u0027).first().json.thema || \u0027(nicht genannt)\u0027;\nconst zeilen = [\n  \u0027STATUS: OK\u0027,\n  \u0027Marke: \u0027 + (m.name || \u0027\u0027),\n  \u0027Ton: \u0027 + (m.ton || \u0027\u0027),\n  \u0027Zielgruppe: \u0027 + (m.zielgruppe || \u0027\u0027),\n  \u0027No-Gos: \u0027 + ((m.no_gos || []).join(\u0027, \u0027) || \u0027keine\u0027),\n  \u0027Call to Action: \u0027 + (m.cta_text || \u0027\u0027),\n  \u0027Feste Hashtags: \u0027 + ((m.hashtags_fest || []).join(\u0027 \u0027) || \u0027keine\u0027),\n  \u0027Thema der Anfrage: \u0027 + thema,\n  \u0027Frühere Posts (neueste zuerst, höchstens 20):\u0027,\n  liste\n];\nreturn [{ json: { antwort: zeilen.join(\u0027\\n\u0027) } }];"
                                     },
