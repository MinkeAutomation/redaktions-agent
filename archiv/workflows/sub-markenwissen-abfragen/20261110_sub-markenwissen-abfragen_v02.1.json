                  {
                      "parameters":  {
                                         "jsCode":  "// Guardrail Ebene 2: nur gültige Kundenkennung, Thema gekürzt\nconst out = [];\nfor (const item of $input.all()) {\n  const kuerzel = String(item.json.kuerzel ?? \u0027\u0027).trim().toLowerCase();\n  const thema = String(item.json.thema ?? \u0027\u0027).trim().slice(0, 300);\n  const ok = /^[a-z0-9-]{2,40}$/.test(kuerzel);\n  out.push({ json: { kuerzel: kuerzel, thema: thema, eingabe_ok: ok } });\n}\nreturn out.slice(0, 1);"
                                     },
