                      "parameters":  {
                                         "jsCode":  "// Guardrail Ebene 3: Pflichtfelder, erlaubte Statuswerte, kein Erfolg ohne post_id, verbotene Muster\nconst item = $input.first().json;\nconst roh = String(item.output ?? \u0027\u0027);\nlet daten = null;\nconst treffer = roh.match(/\\{[\\s\\S]*\\}/);\ntry { daten = treffer ? JSON.parse(treffer[0]) : null; } catch (e) { daten = null; }\nconst erlaubt = [\u0027eingereicht\u0027, \u0027abgelehnt\u0027, \u0027rueckfrage\u0027, \u0027fehler\u0027];\nconst funde = [];\nif (!daten) {\n  funde.push(\u0027kein gültiges JSON\u0027);\n} else {\n  for (const f of [\u0027prompt_version\u0027, \u0027status\u0027, \u0027hinweis_an_mensch\u0027, \u0027toolentscheidung\u0027]) {\n    if (!(f in daten)) funde.push(\u0027Feld fehlt: \u0027 + f);\n  }\n  if (!erlaubt.includes(daten.status)) funde.push(\u0027Status nicht erlaubt: \u0027 + daten.status);\n  if (daten.status === \u0027eingereicht\u0027 \u0026\u0026 !String(daten.post_id || \u0027\u0027).trim()) funde.push(\u0027eingereicht ohne post_id\u0027);\n}\nconst muster = [/sk-[A-Za-z0-9-]{10,}/, /nvapi-/i, /eyJ[A-Za-z0-9_-]{10,}/, /k1_kunden|k1_posts|k2_v_|supabase\\.co/i, /Prompt-Version:|Guardrails\\)/];\nfor (const r of muster) { if (r.test(roh)) funde.push(\u0027verbotenes Muster: \u0027 + r.source); }\nconst schritte = (item.intermediateSteps || []).map(s =\u003e (s.action \u0026\u0026 s.action.tool) || \u0027?\u0027);\nconst ok = funde.length === 0;\nlet text;\nif (ok) {\n  text = \u0027Status: \u0027 + daten.status + \u0027\\n\u0027 + daten.hinweis_an_mensch + (daten.rueckfrage ? \u0027\\nRückfrage: \u0027 + daten.rueckfrage : \u0027\u0027) + (daten.post_id ? \u0027\\nBeitrag: \u0027 + daten.post_id : \u0027\u0027);\n} else {\n  text = \u0027Die Antwort des Agenten hat die Ausgabe-Prüfung nicht bestanden (\u0027 + funde.join(\u0027; \u0027) + \u0027). Ein Mensch sieht sich den Lauf an.\u0027;\n}\nreturn [{ json: { output: text, pruefung_ok: ok, funde: funde, werkzeuge_aufgerufen: schritte, agent_json: daten, prompt_version: $(\u0027Konfiguration [Edit Fields]\u0027).first().json.prompt_version, trace_id: $(\u0027Konfiguration [Edit Fields]\u0027).first().json.trace_id } }];"
