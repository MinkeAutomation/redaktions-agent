                                       600,
                                       0
                                   ],
                      "parameters":  {
                                         "jsCode":  "// Testkopie von Werkzeug 3: Eingabe prüfen (Kopf wie im Original)\nconst j = $input.first().json;\nconst kuerzel = String(j.kuerzel ?? \u0027\u0027).trim().toLowerCase();\nconst briefing = String(j.briefing ?? \u0027\u0027).trim().slice(0, 4000);\nconst nachbesserung = String(j.nachbesserung ?? \u0027\u0027).trim().slice(0, 1000);\nconst trace = String(j.trace_id ?? \u0027\u0027).trim().slice(0, 60) || \u0027ohne_trace_id\u0027;\nconst t = String(j.test_fehler ?? \u0027\u0027).trim();\nconst test = (t === \u0027haupt\u0027 || t === \u0027beide\u0027) ? t : \u0027\u0027;\nlet fehler = \u0027\u0027;\nif (!/^[a-z0-9-]{2,40}$/.test(kuerzel)) fehler = \u0027FEHLER: ungültige Kundenkennung, Paket nicht erstellt.\u0027;\nelse if (briefing.length \u003c 40) fehler = \u0027FEHLER: Briefing fehlt oder ist zu kurz (mindestens 40 Zeichen mit Thema, Kernaussage und belegten Fakten), Paket nicht erstellt.\u0027;\nreturn [{ json: { kuerzel: kuerzel, briefing: briefing, nachbesserung: nachbesserung, trace_id: trace, test_fehler: test, eingabe_ok: fehler === \u0027\u0027, fehler_text: fehler } }];\n"
                                     }
                  },
