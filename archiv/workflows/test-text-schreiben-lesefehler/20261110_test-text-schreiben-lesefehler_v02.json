                  {
                      "id":  "64009e27-bcd6-4f43-b05b-9352ab39118f",
                      "name":  "Markenprofil lesen [Supabase]",
                      "type":  "n8n-nodes-base.supabase",
                      "typeVersion":  1,
                      "position":  [
                                       1200,
                                       0
                                   ],
                      "parameters":  {
                                         "operation":  "getAll",
                                         "tableId":  "k2_v_markenwissen_FALSCH",
                                         "limit":  1,
                                         "matchType":  "allFilters",
                                         "filters":  {
