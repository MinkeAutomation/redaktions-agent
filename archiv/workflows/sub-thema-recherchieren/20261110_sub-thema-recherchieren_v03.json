                  {
                      "parameters":  {
                                         "jsCode":  "// Guardrail Ebene 2: Thema und Fragen kurz halten, leere Eingabe abweisen, harte Obergrenze je Auftrag (10.11.2026).\n// Warum Zaehler im Sub: das Werkzeug kostet Geld (Sonar ueber den Schluessel). Der Prompt erlaubt 1 Aufruf, ein Modell haelt sich nicht sicher daran (Lauf 2564: 4 statt 1).\n// Der Zaehler steht in den Workflow-Daten (Static Data), Schluessel ist die trace_id des Hauptlaufs. Er zaehlt jeden gueltigen Aufruf, auch einen fehlgeschlagenen.\nconst j = $input.first().json;\nconst MAX_AUFRUFE = 2; // 1 Recherche plus 1 Wiederholung nach FEHLER; jeder weitere Aufruf bekommt FEHLER ohne Sonar\nconst thema = String(j.thema ?? \u0027\u0027).trim().slice(0, 300);\nconst fragen = String(j.fragen ?? \u0027\u0027).trim().slice(0, 600);\nconst trace = String(j.trace_id ?? \u0027\u0027).trim().slice(0, 60) || \u0027ohne_trace_id\u0027;\nconst sd = $getWorkflowStaticData(\u0027global\u0027);\nif (!sd.recherche_zaehler || typeof sd.recherche_zaehler !== \u0027object\u0027) sd.recherche_zaehler = {};\nconst jetzt = Date.now();\n// alte Eintraege nach 6 Stunden entfernen, damit die Tabelle nicht waechst\nfor (const k of Object.keys(sd.recherche_zaehler)) { if (jetzt - (sd.recherche_zaehler[k].zeit || 0) \u003e 6 * 3600 * 1000) delete sd.recherche_zaehler[k]; }\nlet fehler = \u0027\u0027;\nlet nr = 0;\nif (thema.length \u003c 3) {\n  fehler = \u0027FEHLER: Thema fehlt oder ist zu kurz, Recherche nicht ausgeführt.\u0027;\n} else {\n  const z = sd.recherche_zaehler[trace] || { n: 0, zeit: jetzt };\n  z.n += 1; z.zeit = jetzt;\n  sd.recherche_zaehler[trace] = z;\n  nr = z.n;\n  if (z.n \u003e MAX_AUFRUFE) fehler = \u0027FEHLER: Grenze für Recherchen in diesem Auftrag erreicht (höchstens \u0027 + MAX_AUFRUFE + \u0027), keine weitere Recherche.\u0027;\n}\nreturn [{ json: { thema: thema, fragen: fragen, trace_id: trace, aufruf_nr: nr, eingabe_ok: fehler === \u0027\u0027, fehler_text: fehler } }];\n"
                                     },
