                  {
                      "parameters":  {
                                         "jsCode":  "// Rückgabe an den Agenten: Fakten mit Quelle, Kosten aus usage.cost, feste Nicht-Treffer-Werte\n// v02 (10.11.2026): nur Fakten, deren Link-Host in den echten Suchtreffern der Antwort steht (citations, annotations); Zeilen auf 400 Zeichen begrenzt.\n// v03 (10.11.2026): Sonar schreibt Quellen oft als Fußnote [n] statt als Link (Lauf 2601: 5 belegte Zeilen, 14 Suchtreffer, trotzdem NICHT_GEFUNDEN, bezahlt). Die Fußnote [n] zeigt auf den n-ten Suchtreffer (citations, sonst annotations); die Zeile bekommt den Link dieses Treffers. Eine Fußnote ohne Suchtreffer bleibt unbelegt und wird verworfen.\nconst r = $input.first().json || {};\nif (r.error) {\n  const m = (r.error \u0026\u0026 (r.error.message || r.error)) || \u0027unbekannt\u0027;\n  return [{ json: { antwort: \u0027FEHLER: Recherche nicht erreichbar (\u0027 + String(m).slice(0, 160) + \u0027).\u0027, kosten_usd: null } }];\n}\nconst msg = (((r.choices || [])[0] || {}).message) || {};\nconst text = String(msg.content || \u0027\u0027).trim();\nconst kosten = (r.usage \u0026\u0026 typeof r.usage.cost === \u0027number\u0027) ? r.usage.cost : null;\nconst tokens = r.usage ? (r.usage.total_tokens || null) : null;\n// echte Quellen: Suchtreffer der Antwort in ihrer Reihenfolge, nicht der Text des Modells\nconst cit = (Array.isArray(r.citations) ? r.citations : []).filter(c =\u003e typeof c === \u0027string\u0027);\nconst ann = (Array.isArray(msg.annotations) ? msg.annotations : []).map(a =\u003e a \u0026\u0026 ((a.url_citation \u0026\u0026 a.url_citation.url) || a.url)).filter(u =\u003e typeof u === \u0027string\u0027);\nconst treffer = cit.length \u003e 0 ? cit : ann;\nconst urls = cit.concat(ann);\nconst host = u =\u003e String(u).replace(/^https?:\\/\\/(www\\.)?/i, \u0027\u0027).split(/[\\/?#]/)[0].toLowerCase();\nconst hosts = new Set(urls.map(host).filter(Boolean));\nconst kuerzen = s =\u003e (s.length \u003e 400 ? s.slice(0, 399).trimEnd() + \u0027…\u0027 : s);\nconst zeilen0 = text.split(\u0027\\n\u0027).map(z =\u003e z.trim()).filter(z =\u003e z.startsWith(\u0027-\u0027));\nconst FUSS = /\\[(\\d{1,2})\\]/g;\nlet vorher = 0;\nconst fakten = [];\nfor (const z of zeilen0) {\n  if (/https?:\\/\\//.test(z)) {\n    // Zeile mit Link: nur behalten, wenn der Host in den Suchtreffern steht (ohne Suchtreffer bleibt die Link-Prüfung des Modells)\n    vorher += 1;\n    if (hosts.size \u003e 0 \u0026\u0026 !(z.match(/https?:\\/\\/[^\\s)\\],]+/g) || []).some(u =\u003e hosts.has(host(u)))) continue;\n    fakten.push(kuerzen(z));\n    continue;\n  }\n  const nummern = Array.from(z.matchAll(FUSS)).map(m =\u003e parseInt(m[1], 10));\n  if (nummern.length === 0) continue; // weder Link noch Fußnote: unbelegt\n  vorher += 1;\n  const quellen = [];\n  let alleGefunden = true;\n  for (const n of nummern) { const u = treffer[n - 1]; if (typeof u !== \u0027string\u0027) alleGefunden = false; else if (!quellen.includes(u)) quellen.push(u); }\n  if (!alleGefunden || quellen.length === 0) continue; // eine Fußnote ohne Suchtreffer: die Zeile gilt als unbelegt\n  const nutz = quellen.slice(0, 2);\n  const suffix = \u0027 (Quelle: \u0027 + nutz.join(\u0027; \u0027) + \u0027)\u0027;\n  if (suffix.length \u003e 350) continue; // Link zu lang, um die Zeile sinnvoll zu kürzen\n  let koerper = z.replace(FUSS, \u0027\u0027).replace(/\\s+([.,;:])/g, \u0027$1\u0027).replace(/\\s{2,}/g, \u0027 \u0027).trim();\n  if (koerper.length + suffix.length \u003e 400) koerper = koerper.slice(0, 400 - suffix.length - 1).trimEnd() + \u0027…\u0027;\n  fakten.push(koerper + suffix);\n}\nif (!text || /KEINE_BELEGE/.test(text) || fakten.length === 0) {\n  return [{ json: { antwort: \u0027NICHT_GEFUNDEN: Keine belegten Fakten zu diesem Thema gefunden.\u0027, kosten_usd: kosten, tokens: tokens, quellen_treffer: hosts.size, fakten_verworfen: vorher } }];\n}\nconst zeilen = [\u0027STATUS: OK\u0027, \u0027Fakten mit Quelle (nur diese verwenden):\u0027].concat(fakten.slice(0, 5));\nreturn [{ json: { antwort: zeilen.join(\u0027\\n\u0027), kosten_usd: kosten, tokens: tokens, quellen_treffer: hosts.size, fakten_verworfen: vorher - fakten.length } }];\n"
                                     },
