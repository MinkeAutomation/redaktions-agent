                  {
                      "parameters":  {
                                         "jsCode":  "// Guardrail Ebene 2: Thema und Fragen kurz halten, leere Eingabe abweisen\nconst j = $input.first().json;\nconst thema = String(j.thema ?? \u0027\u0027).trim().slice(0, 300);\nconst fragen = String(j.fragen ?? \u0027\u0027).trim().slice(0, 600);\nreturn [{ json: { thema: thema, fragen: fragen, eingabe_ok: thema.length \u003e= 3 } }];"
                                     },
