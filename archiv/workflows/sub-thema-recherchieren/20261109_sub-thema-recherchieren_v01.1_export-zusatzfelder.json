                      "onError":  "continueRegularOutput"
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// Rückgabe an den Agenten: Fakten mit Quelle, Kosten aus usage.cost, feste Nicht-Treffer-Werte\nconst r = $input.first().json || {};\nif (r.error) {\n  const m = (r.error \u0026\u0026 (r.error.message || r.error)) || \u0027unbekannt\u0027;\n  return [{ json: { antwort: \u0027FEHLER: Recherche nicht erreichbar (\u0027 + String(m).slice(0, 160) + \u0027).\u0027, kosten_usd: null } }];\n}\nconst text = String((((r.choices || [])[0] || {}).message || {}).content || \u0027\u0027).trim();\nconst kosten = (r.usage \u0026\u0026 typeof r.usage.cost === \u0027number\u0027) ? r.usage.cost : null;\nconst tokens = r.usage ? (r.usage.total_tokens || null) : null;\nconst fakten = text.split(\u0027\\n\u0027).map(z =\u003e z.trim()).filter(z =\u003e z.startsWith(\u0027-\u0027) \u0026\u0026 /https?:\\/\\//.test(z));\nif (!text || /KEINE_BELEGE/.test(text) || fakten.length === 0) {\n  return [{ json: { antwort: \u0027NICHT_GEFUNDEN: Keine belegten Fakten zu diesem Thema gefunden.\u0027, kosten_usd: kosten, tokens: tokens } }];\n}\nconst zeilen = [\u0027STATUS: OK\u0027, \u0027Fakten mit Quelle (nur diese verwenden):\u0027].concat(fakten.slice(0, 5));\nreturn [{ json: { antwort: zeilen.join(\u0027\\n\u0027), kosten_usd: kosten, tokens: tokens } }];"
                                     },
