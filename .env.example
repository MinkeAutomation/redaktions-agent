# Echte Werte nie ins Repo, nur in die n8n-Credentials.
#
# Die Workflows lesen keine Umgebungsvariablen. Diese Datei listet nur die Namen der Werte auf, die du in n8n
# (Credentials und Platzhalter, siehe README, Abschnitt Importhinweise) und in der Datenbank eintragen musst.
# Werte leer lassen oder nur im eigenen, nicht committeten Notizdokument pflegen. Eine Datei mit echten Werten
# darf nie .env.example heißen und nie ins Repo (.gitignore schützt .env und *.env).

# --- Datenbank: Credential "Supabase API" (Hauptworkflow, Freigabe-Workflow, Fristen-Workflow, Werkzeuge 1, 3, 4, 5, 6) ---
# Projekt-Adresse (https://<projekt>.supabase.co) ohne https:// davor, weil es im Export schon steht, und ohne Schrägstrich
# am Ende, zum Beispiel abcdefgh.supabase.co; ersetzt SUPABASE_URL in https://SUPABASE_URL in den Exporten
# (Stellen je Datei: README, Importhinweise).
SUPABASE_URL=
# Service-Key der Datenbank, nur im n8n-Credential "Supabase API" eintragen.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sprachmodelle: 2 Credentials "OpenRouter API" (Typ OpenAI-API, Basisadresse von OpenRouter) ---
# Zugang 1, kostenpflichtig: Agent-Modell im Hauptworkflow, Recherche-Werkzeug (Perplexity Sonar), Prüfmodell in Qualität prüfen.
OPENROUTER_API_KEY=
# Zugang 2, kostenlose Modelle: Eingangs- und Ausgangsprüfung, Reserve-Modell, Text-Werkzeug, Ersatzmodell in Qualität prüfen.
OPENROUTER_API_KEY_FREE=

# --- Telegram: Credential "Telegram API" (Hauptworkflow, Freigabe-Workflow, Fristen-Workflow) ---
TELEGRAM_BOT_TOKEN=
# Diese 3 Werte stehen nicht in n8n, sondern als Zeilen (Schlüssel, Wert) in der Tabelle k1_einstellungen:
#   telegram_chat_id, telegram_freigabe_nutzer_id, cloudflare_account_id
# Dazu als Pflichtzeilen in k1_einstellungen: freigabe_frist_minuten (1 bis 1440) und freigabe_puffer_minuten (0 bis 120).
TELEGRAM_CHAT_ID=
TELEGRAM_FREIGABE_NUTZER_ID=
CLOUDFLARE_ACCOUNT_ID=

# --- Bilder: Werkzeug 4 ---
# Credential "Pixabay API" (Typ Query-Auth; Parametername und Wert nach der Pixabay-Dokumentation, üblich key).
PIXABAY_API_KEY=
# Credential "Cloudflare Workers AI" (Typ Header-Auth; Headername und Wert nach der Cloudflare-Dokumentation,
# üblich Authorization mit "Bearer <Token>").
CLOUDFLARE_API_TOKEN=
# Nur der Hostname des eigenen Gotenberg-Dienstes, ohne Protokoll und ohne Port (zum Beispiel gotenberg);
# ersetzt den Platzhalter GOTENBERG_HOST in sub-bilder-gestalten.json, dort steht schon http://GOTENBERG_HOST:3000.
# Gotenberg selbst lauscht auf Port 3000 (3999 ist ein Testschalter für einen Ausfall).
GOTENBERG_HOST=
# Storage-Bucket für die Bilder in Supabase (der Name steht fest in den Exporten).
SUPABASE_STORAGE_BUCKET=k1-medien

# --- Chat-Seite: Credential "Basic Auth" (Anmeldung der Chat-Seite im Hauptworkflow) ---
CHAT_BASIC_AUTH_USER=
CHAT_BASIC_AUTH_PASSWORT=

# --- n8n-Instanz ---
# Hostname der eigenen Instanz ohne https://, ohne Schrägstrich am Ende und ohne Pfad (zum Beispiel n8n.example.org);
# ersetzt DEINE-N8N-INSTANZ in allen Dateien in 1 Durchgang: Chat-Eingang (dort steht https:// schon davor),
# Sperrliste der Ausgabe-Prüfung und Notizen (README, Importhinweise).
N8N_INSTANZ_HOST=
# Eigener Fehler-Workflow; ersetzt ERROR_WORKFLOW_ID in den Einstellungen aller 9 Workflows, oder die Zeile entfällt dort.
# Im Ablage-Workflow steht an dieser Stelle (errorWorkflow) eine feste Kennung der Ursprungsinstanz: ersetzen oder entfernen.
ERROR_WORKFLOW_ID=

# --- Nextcloud: Credential "NextCloud API" im Ablage-Workflow aus Projekt 1 (content-maschine-k1),
# in den 7 Nextcloud-Knoten und im Knoten Freigabelink erzeugen [HTTP Request] wählen ---
# Adresse der eigenen Nextcloud ohne https://, einschließlich eines vorhandenen Installationspfads und ohne abschließenden Schrägstrich (zum Beispiel cloud.example.org/nextcloud); ersetzt NEXTCLOUD_URL in sub-nextcloud-ablage.json (3 Stellen).
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_APP_PASSWORT=

# --- Workflow-IDs, erst nach dem Import der Werkzeuge bekannt (README, Importhinweise, Schritt 3) ---
WORKFLOW_ID_SUB_MARKENWISSEN=
WORKFLOW_ID_SUB_RECHERCHE=
WORKFLOW_ID_SUB_TEXT=
WORKFLOW_ID_SUB_BILDER=
WORKFLOW_ID_SUB_EINREICHEN=
WORKFLOW_ID_SUB_QUALITAET=
# Freigabe-Workflow (sub-freigabe-abwarten-und-ablegen.json), steht im Hauptworkflow im Knoten Freigabe starten.
WORKFLOW_ID_SUB_FREIGABE=
# Ablage-Workflow aus Projekt 1 (workflows/sub-nextcloud-ablage.json im Repo content-maschine-k1); sein Nextcloud-Zugang
# liegt in diesem Workflow, nicht in diesem Repo.
WORKFLOW_ID_NEXTCLOUD_ABLAGE=
# Nur für die Sperrliste der Ausgabe-Prüfung (optional): Hauptworkflow selbst und Hauptworkflow von Projekt 1.
WORKFLOW_ID_REDAKTIONS_AGENT=
WORKFLOW_ID_PROJEKT_1=
