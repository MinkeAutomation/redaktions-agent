# Echte Werte nie ins Repo, nur in die n8n-Credentials.
#
# Die Workflows lesen keine Umgebungsvariablen. Diese Datei listet nur die Namen der Werte auf, die du in n8n
# (Credentials und Platzhalter, siehe README, Abschnitt Importhinweise) und in der Datenbank eintragen musst.
# Werte leer lassen oder nur im eigenen, nicht committeten Notizdokument pflegen. Eine Datei mit echten Werten
# darf nie .env.example heißen und nie ins Repo (.gitignore schützt .env und *.env).

# --- Datenbank: Credential "Supabase API" (6 Knoten im Hauptworkflow, Werkzeuge 1, 3, 4, 5) ---
# Adresse der eigenen Supabase-Datenbank; ersetzt den Platzhalter https://SUPABASE_URL in den Exporten (13 Stellen).
SUPABASE_URL=
# Service-Key der Datenbank, nur im n8n-Credential "Supabase API" eintragen.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sprachmodelle: Credential "OpenRouter API" (Typ OpenAI-API, Basisadresse von OpenRouter) ---
# Agent-Modell im Hauptworkflow, Text-Werkzeug (Ersatzmodell) und Recherche-Werkzeug (Perplexity Sonar).
OPENROUTER_API_KEY=

# --- Telegram: Credential "Telegram API" (5 Telegram-Knoten im Hauptworkflow) ---
TELEGRAM_BOT_TOKEN=
# Diese 3 Werte stehen nicht in n8n, sondern als Zeilen (Schlüssel, Wert) in der Tabelle k1_einstellungen:
#   telegram_chat_id, telegram_freigabe_nutzer_id, cloudflare_account_id
TELEGRAM_CHAT_ID=
TELEGRAM_FREIGABE_NUTZER_ID=
CLOUDFLARE_ACCOUNT_ID=

# --- Bilder: Werkzeug 4 ---
# Credential "Pixabay API" (Typ Query-Auth; Parametername und Wert nach der Pixabay-Dokumentation, üblich key).
PIXABAY_API_KEY=
# Credential "Cloudflare Workers AI" (Typ Header-Auth; Headername und Wert nach der Cloudflare-Dokumentation,
# üblich Authorization mit "Bearer <Token>").
CLOUDFLARE_API_TOKEN=
# Adresse des eigenen Gotenberg-Dienstes ohne Protokoll, Port 3000 (3999 ist ein Testschalter für einen Ausfall);
# ersetzt den Platzhalter GOTENBERG_HOST in sub-bilder-gestalten.json.
GOTENBERG_HOST=
# Storage-Bucket für die Bilder in Supabase (der Name steht fest in den Exporten).
SUPABASE_STORAGE_BUCKET=k1-medien

# --- n8n-Instanz ---
# Hostname der eigenen Instanz ohne https://; gehört in die Sperrliste der Ausgabe-Prüfung (README, Importhinweise)
# und ersetzt den Platzhalter DEINE-N8N-INSTANZ.
N8N_INSTANZ_HOST=
# Eigener Fehler-Workflow; ersetzt ERROR_WORKFLOW_ID oder die Zeile entfällt.
ERROR_WORKFLOW_ID=

# --- Workflow-IDs, erst nach dem Import der Werkzeuge bekannt (README, Importhinweise, Schritt 3) ---
WORKFLOW_ID_SUB_MARKENWISSEN=
WORKFLOW_ID_SUB_RECHERCHE=
WORKFLOW_ID_SUB_TEXT=
WORKFLOW_ID_SUB_BILDER=
WORKFLOW_ID_SUB_EINREICHEN=
# Ablage-Workflow aus Projekt 1 (workflows/sub-nextcloud-ablage.json im Repo content-maschine-k1); sein Nextcloud-Zugang
# liegt in diesem Workflow, nicht in diesem Repo.
WORKFLOW_ID_NEXTCLOUD_ABLAGE=
# Nur für die Sperrliste der Ausgabe-Prüfung (optional): Hauptworkflow selbst und Hauptworkflow von Projekt 1.
WORKFLOW_ID_REDAKTIONS_AGENT=
WORKFLOW_ID_PROJEKT_1=
