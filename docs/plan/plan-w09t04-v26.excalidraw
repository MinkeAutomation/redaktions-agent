   "versionNonce": 1693422314,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Mit dem Finger lesen: D1 bis D35 ist ein Lauf mit Freigabe, D36 bis D54 sind die Nebenwege, D55 bis D59 der Freigabe-Workflow, E1 und E2 der Fehlerfall. Pfeil mit 2 Spitzen: Daten hin und Antwort zurück.",
   "originalText": "Mit dem Finger lesen: D1 bis D35 ist ein Lauf mit Freigabe, D36 bis D54 sind die Nebenwege, D55 bis D59 der Freigabe-Workflow, E1 und E2 der Fehlerfall. Pfeil mit 2 Spitzen: Daten hin und Antwort zurück.",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 19,
   "autoResize": true
  },
  {
   "id": "e0004",
   "type": "text",
   "x": 40,
   "y": 150,
   "width": 2394.0800000000004,
   "height": 27.5,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 938525173,
   "version": 1,
   "versionNonce": 1435597814,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Farben: blau Schritt in n8n, grün externer Dienst, gelb Datenbank Supabase (eu-west-1), rosa Neben- und Fehlerweg, grau gestrichelt Mensch oder eigener Workflow. Tabelle rechts: Daten je Nummer.",
   "originalText": "Farben: blau Schritt in n8n, grün externer Dienst, gelb Datenbank Supabase (eu-west-1), rosa Neben- und Fehlerweg, grau gestrichelt Mensch oder eigener Workflow. Tabelle rechts: Daten je Nummer.",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 19,
   "autoResize": true
  },
  {
