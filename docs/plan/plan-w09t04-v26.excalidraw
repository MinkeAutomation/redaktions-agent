   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Stand 21.11.2026: Hauptworkflow v26.5.3, Systemprompt v4.4, Freigabe-Workflow v02.1, Text-Werkzeug v09.3, Werkzeug 6 Qualität prüfen.",
   "originalText": "Stand 21.11.2026: Hauptworkflow v26.5.3, Systemprompt v4.4, Freigabe-Workflow v02.1, Text-Werkzeug v09.3, Werkzeug 6 Qualität prüfen.",
