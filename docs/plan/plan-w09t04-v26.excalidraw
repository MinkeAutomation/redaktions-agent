      "versionNonce": 985979547,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Merke: Abgelegt wird nur nach Freigabe eines\nMenschen, veröffentlicht wird nie von einem Knoten.\nModell- und Bilddienste (D2, D3, D5, D6, D8a, D8b,\nD11) bekommen ihre Daten schon vor der Freigabe.",
      "originalText": "Merke: Abgelegt wird nur nach Freigabe eines\nMenschen, veröffentlicht wird nie von einem Knoten.\nModell- und Bilddienste (D2, D3, D5, D6, D8a, D8b,\nD11) bekommen ihre Daten schon vor der Freigabe.",
      "fontSize": 32,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 29,
